<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Every test hosts its own app, 16 at a time: workstation GC's single heap stalls them all
      (about a third of the run's wall time).
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wwg.Api\Wwg.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The hex grid's expected figures, shared with the front-end's tests. -->
    <None
      Include="../../../testdata/hex-grid.json"
      Link="testdata/hex-grid.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="../../../testdata/movement.json"
      Link="testdata/movement.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <!-- The club's unit library (decision 0025), imported whole by a test. -->
    <None
      Include="../../../docs/complete_library.csv"
      Link="testdata/complete_library.csv"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
